# ==============================================================================
# GUELMAGUIDE ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file serves as a template for production environment variables.
# For security:
# - Use GitHub Secrets for CI/CD
# - Use Vercel Dashboard for Frontend variables
# - Use Railway Dashboard for Backend variables
# ==============================================================================

# --- DATABASE (Railway / Neon) ---
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db

# --- CACHE & BACKGROUND TASKS (Upstash / Redis) ---
REDIS_URL=redis://default:token@host:6379/0

# --- SECURITY (Required on BOTH) ---
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=

# --- FRONTEND (Vercel) ---
# Prefixed with NEXT_PUBLIC_ to be available in the browser
NEXT_PUBLIC_APP_URL=https://guelma.guide
NEXT_PUBLIC_API_BASE_URL=https://guelma.guide/api/v1
NEXT_PUBLIC_GEMINI_API_KEY=

# --- BACKEND (Railway) ---
# Internal proxy URL for Next.js Server Components
API_BASE_URL=https://api.guelma.guide/api/v1
BACKEND_CORS_ORIGINS=https://guelma.guide,http://localhost:3000
FRONTEND_BASE_URL=https://guelma.guide

# --- AUTH (Google Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.guelma.guide/api/v1/auth/google/callback

# --- STORAGE (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=

# --- PAYMENTS (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# --- OBSERVABILITY (Sentry) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
APP_ENV=production

# --- EMAIL (Resend) ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Guelma Guide <noreply@guelma.guide>
