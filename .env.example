# Frontend public app URL used for metadata/sitemap/robots
NEXT_PUBLIC_APP_URL=https://guelma.guide
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Server-side URL for Next.js Route Handlers to reach the backend (defaults to NEXT_PUBLIC_API_BASE_URL if not set)
API_BASE_URL=http://localhost:8000/api/v1
# Explicitly control secure cookie flag. Defaults to true when NODE_ENV=production. Set to 'false' for local HTTPS dev.
# COOKIE_SECURE=true

# Backend API settings
PROJECT_NAME=Guelma Guide API
PROJECT_VERSION=0.1.0
API_V1_PREFIX=/api/v1
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
JWT_SECRET_KEY=replace_with_at_least_32_chars_secret
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/guelma_guide
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_PER_WINDOW=10
RATE_LIMIT_REGISTER_PER_WINDOW=10
RATE_LIMIT_AI_PER_WINDOW=30

# Future integrations
AI_API_KEY=
MAPS_API_KEY=
# Resend email service for transactional emails (password reset etc.)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Guelma Guide <noreply@guelma.guide>
# Base URL of the frontend — used to build password-reset links sent via email
FRONTEND_BASE_URL=http://localhost:3000
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional demo onboarding credentials displayed in the frontend
NEXT_PUBLIC_DEMO_USER_EMAIL=
NEXT_PUBLIC_DEMO_USER_PASSWORD=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

